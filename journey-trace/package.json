{
  "name": "journey-trace",
  "version": "0.1.0",
  "description": "Deterministic, git-native golden-trace testing for Playwright user journeys, with an MCP server for AI-assisted root-cause triage.",
  "type": "module",
  "bin": {
    "journey-trace": "./bin/journey-trace.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
