# Copy this file to .env and fill in values as needed.

# Phase 1 (optional overrides — defaults point at the public OrangeHRM demo)
# ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
# ORANGEHRM_USERNAME=Admin
# ORANGEHRM_PASSWORD=admin123

# Phase 2 — local Ollama (default, no API key required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Phase 2 — hosted provider instead of Ollama (never commit a real key)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
